{
  "name": "markdown-to-image",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-pages.mjs && node scripts/test-static-pages.mjs",
